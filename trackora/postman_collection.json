          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const j = pm.response.json();", "  const list = j.results || j;", "  if (list[0]) pm.collectionVariables.set('user_id', list[0].id);", "}"]}}]
